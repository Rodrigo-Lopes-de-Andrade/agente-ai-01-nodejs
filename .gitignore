# ---- Python (versao original do capitulo, Streamlit) ----
.venv/
__pycache__/
.ipynb_checkpoints/
*.pyc
.streamlit/secrets.toml

# ---- Chaves de API: NUNCA versionar ----
# O .env fica so na sua maquina. Na Vercel as chaves entram pelo painel
# (Settings > Environment Variables). O .env.example, sem valores, e versionado
# de proposito: e o modelo que o proximo aluno copia.
.env
.env.local
.env.*.local

# ---- Node.js / Next.js (versao nova) ----
# node_modules e a .venv do JavaScript: pesa centenas de MB e e recriada por
# 'npm install' a partir do package.json + package-lock.json.
/node_modules
# .next e a pasta de build gerada por 'next dev' e 'next build'.
/.next/
/out/
# next-env.d.ts e gerado pelo Next.js a cada 'dev'/'build'.
next-env.d.ts
*.tsbuildinfo
# .vercel guarda a ligacao local do projeto com a sua conta (criada por 'vercel link').
.vercel
# logs
npm-debug.log*

# ---- Residuos do Windows (metadados criados ao copiar arquivos pela rede) ----
*:Zone.Identifier
